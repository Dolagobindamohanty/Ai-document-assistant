# ==============================================================================
# AI Document Assistant - Environment Configuration Example
# Copy this file to .env and configure your actual values.
# NEVER commit your actual .env file or expose real API keys.
# ==============================================================================

# 1. Google Gemini API Configuration (Required)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_PRIMARY_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODELS="gemini-3.6-flash,gemini-3.5-flash-lite"

# 2. Embedding Model & Vector Indexing Configuration
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# 3. Retrieval & Relevance Filter Configuration
RETRIEVAL_K=5
RETRIEVAL_FETCH_K=10
MMR_LAMBDA=0.7
MAX_DISTANCE=1.90
MAX_CONTEXT_CHARS=8000

# 4. Document Processing & Ingestion Limits
MAX_UPLOAD_MB=50
LOW_TEXT_CHAR_THRESHOLD=50

# 5. Summarization Pipeline Configuration
SUMMARY_BATCH_BUDGET=12000

# 6. LLM Resilience & Retry Settings
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=2.0

# 7. Privacy & Security Settings
LOG_DOCUMENT_TEXT=false
